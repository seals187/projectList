# Line endings: always LF in the repository and in the working tree
# (also on Windows; Go, Node and Docker use LF throughout).
* text=auto eol=lf

# Never convert binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.db     binary
*.sqlite binary
