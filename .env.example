# ---- ProjectList configuration ----------------------------------------------
# Copy to .env and adjust:  cp .env.example .env

# First admin – only created on the very first start (empty database).
# These values can be removed afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern-123
ADMIN_NAME=Admin

# Image version: latest = newest release, edge = development state, or a fixed version such as 0.0.2
PROJECTLIST_VERSION=latest

# Host port for docker compose
PORT=8080

# Send the session cookie over HTTPS only. On http://localhost this works in
# Chrome/Edge/Firefox. For plain HTTP access via an IP or hostname: false.
COOKIE_SECURE=true

# Session lifetime (Go duration, e.g. 720h = 30 days)
SESSION_TTL=720h

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Optional: subtitle below "ProjectList" in the sidebar
# APP_SUBTITLE=IT Services

# Optional: public address for links in e-mails (invitations, password reset)
# APP_URL=https://projects.example.com

# Optional: e-mail via SMTP (invitations, password reset). Without SMTP_HOST and
# SMTP_FROM the admin copies the link by hand.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ProjectList <noreply@example.com>
# starttls | tls | none
# SMTP_TLS=starttls
