# ---- ProjectList Konfiguration ----------------------------------------------
# Kopieren nach .env und anpassen:  cp .env.example .env

# Erster Admin – wird nur beim allerersten Start angelegt (leere Datenbank).
# Danach können diese Werte entfernt werden.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern-123
ADMIN_NAME=Admin

# Host-Port für docker compose
PORT=8080

# Session-Cookie nur über HTTPS senden. Auf http://localhost funktioniert das in
# Chrome/Edge/Firefox. Für Zugriff per HTTP über eine IP/Hostname: false.
COOKIE_SECURE=true

# Gültigkeit einer Session (Go-Duration, z. B. 720h = 30 Tage)
SESSION_TTL=720h

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# Optional: Untertitel unter "ProjectList" in der Seitenleiste
# APP_SUBTITLE=IT Services
